{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "build/tsc/tools"
  },
  "include": [
    "vitest.config.ts",
    "vitest.mutation.config.ts",
    "vitest.unit.ts",
    "scripts/ai-review-answers.ts",
    "scripts/changed-code.ts",
    "scripts/ci-gate.ts",
    "scripts/mutation-base.ts",
    "scripts/engine-work.ts",
    "scripts/mutation-report.ts",
    "scripts/performance-limits.ts",
    "scripts/queue-tested.ts",
    "scripts/mutation-summary.ts",
    "scripts/mutation-triage.ts",
    "scripts/mutation-run.ts",
    "scripts/release-on-main.ts",
    "scripts/release-version.ts",
    "scripts/ci-retry.ts",
    "scripts/frame-barcode/*.ts",
    "scripts/tests/**/*.ts"
  ],
  "references": [{ "path": "protocol" }, { "path": "ui" }]
}
