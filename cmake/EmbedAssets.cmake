# Generates a C++ source that embeds every file under INPUT_DIR (AD-11).
# Usage: cmake -DINPUT_DIR=<dir> -DOUTPUT_FILE=<file.cpp> -P EmbedAssets.cmake
file(GLOB_RECURSE files RELATIVE "${INPUT_DIR}" "${INPUT_DIR}/*")
list(SORT files)
if(NOT files)
    message(FATAL_ERROR "No UI assets found in ${INPUT_DIR}")
endif()

set(arrays "")
set(entries "")
set(index 0)
foreach(file IN LISTS files)
    file(READ "${INPUT_DIR}/${file}" hex HEX)
    string(LENGTH "${hex}" hexLength)
    math(EXPR size "${hexLength} / 2")
    if(size EQUAL 0)
        set(bytes "0x00,")
    else()
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    endif()

    get_filename_component(extension "${file}" LAST_EXT)
    string(TOLOWER "${extension}" extension)
    if(extension STREQUAL ".html")
        set(mime "text/html; charset=utf-8")
    elseif(extension STREQUAL ".js" OR extension STREQUAL ".mjs")
        set(mime "text/javascript; charset=utf-8")
    elseif(extension STREQUAL ".css")
        set(mime "text/css; charset=utf-8")
    elseif(extension STREQUAL ".json" OR extension STREQUAL ".map")
        set(mime "application/json")
    elseif(extension STREQUAL ".svg")
        set(mime "image/svg+xml")
    elseif(extension STREQUAL ".png")
        set(mime "image/png")
    elseif(extension STREQUAL ".woff2")
        set(mime "font/woff2")
    elseif(extension STREQUAL ".wasm")
        set(mime "application/wasm")
    else()
        set(mime "application/octet-stream")
    endif()

    string(APPEND arrays "const unsigned char asset${index}[] = {${bytes}};\n")
    string(APPEND entries "    {\"${file}\", \"${mime}\", asset${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()

set(content "// Generated by cmake/EmbedAssets.cmake. Do not edit.
#include \"EmbeddedAssets.h\"

namespace orizon::editor {
namespace {

${arrays}
const EmbeddedAsset assets[] = {
${entries}};

} // namespace

std::span<const EmbeddedAsset> embeddedAssets()
{
    return assets;
}

} // namespace orizon::editor
")

file(WRITE "${OUTPUT_FILE}.tmp" "${content}")
file(COPY_FILE "${OUTPUT_FILE}.tmp" "${OUTPUT_FILE}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT_FILE}.tmp")
