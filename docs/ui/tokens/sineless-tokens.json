{
  "$description": "Sineless plugin tokens (DTCG format). Dark only, Graphite treatment, accent on Frozen.",
  "sl": {
    "color": {
      "case": {
        "$type": "color",
        "$value": "#1b1b1f",
        "$description": "Window chrome: toolbar, status bar and the frame around the screen"
      },
      "control": {
        "$type": "color",
        "$value": "#2e2e32",
        "$description": "Bar controls at rest: menus, drag fields, switches, Help and About"
      },
      "control-hover": {
        "$type": "color",
        "$value": "#3a3a3e",
        "$description": "A bar control under the pointer"
      },
      "control-open": {
        "$type": "color",
        "$value": "#4c4c50",
        "$description": "A menu whose popover is open"
      },
      "popover": {
        "$type": "color",
        "$value": "#2d2d31",
        "$description": "Open popovers, help tips and the \"+n\" list"
      },
      "track": {
        "$type": "color",
        "$value": "#ffffff0f",
        "$description": "Popover tracks, number fields and buttons in a popover (white 6%)"
      },
      "track-hover": {
        "$type": "color",
        "$value": "#ffffff12",
        "$description": "A popover option under the pointer (white 7%)"
      },
      "line": {
        "$type": "color",
        "$value": "#2c2c30",
        "$description": "The screen's edge, the cursor readout's rule, the resize grip"
      },
      "selected": {
        "$type": "color",
        "$value": "#d4d4d8",
        "$description": "The chosen option, and switches that are on"
      },
      "on-selected": {
        "$type": "color",
        "$value": "#0b0b0c",
        "$description": "Text on a selected option"
      },
      "ink": {
        "$type": "color",
        "$value": "#f5f5f7",
        "$description": "Primary text, values, cursors"
      },
      "ink-2": {
        "$type": "color",
        "$value": "#a5a5a9",
        "$description": "Labels, units, icons, grid labels"
      },
      "screen": {
        "$type": "color",
        "$value": "#030307",
        "$description": "The screen behind the traces"
      },
      "grid": {
        "$type": "color",
        "$value": "#111115",
        "$description": "Time and level grid lines"
      },
      "grid-strong": {
        "$type": "color",
        "$value": "#1c1c20",
        "$description": "Bar lines in Beats; each lane's zero line"
      },
      "lane-edge": {
        "$type": "color",
        "$value": "#26262a",
        "$description": "The line between stacked lanes"
      },
      "accent": {
        "$type": "color",
        "$value": "#ff5f1f",
        "$description": "Frozen only: the Frozen button and the Frozen chip"
      },
      "on-accent": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Text on the accent"
      },
      "warn": {
        "$type": "color",
        "$value": "#ffd23f",
        "$description": "Problems: Invalid samples, tracks that cancel when summed"
      },
      "left": {
        "$type": "color",
        "$value": "#5ab0ff",
        "$description": "Left channel"
      },
      "right": {
        "$type": "color",
        "$value": "#ff5c8a",
        "$description": "Right channel"
      },
      "mid": {
        "$type": "color",
        "$value": "#f5f5f7",
        "$description": "Mid channel, and the sum lane in Compare"
      },
      "side": {
        "$type": "color",
        "$value": "#b3f06b",
        "$description": "Side channel"
      },
      "rim-top": {
        "$type": "color",
        "$value": "#ffffff0d",
        "$description": "A control's rim, a highlight along its top only (white 5%)"
      },
      "rim-open-top": {
        "$type": "color",
        "$value": "#ffffff12",
        "$description": "An open menu's rim, along its top (white 7%)"
      },
      "popover-rim-edge": {
        "$type": "color",
        "$value": "#ffffff0d",
        "$description": "A popover's inner edge all round (white 5%)"
      },
      "popover-edge": {
        "$type": "color",
        "$value": "#000000a6",
        "$description": "A popover's outer edge (black 65%)"
      },
      "popover-drop": {
        "$type": "color",
        "$value": "#0000008c",
        "$description": "A popover's drop shadow (black 55%)"
      },
      "thumb-shade": {
        "$type": "color",
        "$value": "#00000080",
        "$description": "A chosen thumb's shadow (black 50%)"
      },
      "readout-edge": {
        "$type": "color",
        "$value": "#ffffff14",
        "$description": "Readout panels' hairline (white 8%)"
      },
      "lane-hover": {
        "$type": "color",
        "$value": "#ffffff14",
        "$description": "A lane-label button under the pointer (white 8%)"
      }
    },
    "track": {
      "01": {
        "$type": "color",
        "$value": "#6fb6fe"
      },
      "02": {
        "$type": "color",
        "$value": "#e3636c"
      },
      "03": {
        "$type": "color",
        "$value": "#13efe9"
      },
      "04": {
        "$type": "color",
        "$value": "#8f7fed"
      },
      "05": {
        "$type": "color",
        "$value": "#e7a203"
      },
      "06": {
        "$type": "color",
        "$value": "#0bab83"
      },
      "07": {
        "$type": "color",
        "$value": "#dcd848"
      },
      "08": {
        "$type": "color",
        "$value": "#c76ac0"
      },
      "09": {
        "$type": "color",
        "$value": "#98c244"
      },
      "10": {
        "$type": "color",
        "$value": "#feb8e3"
      },
      "11": {
        "$type": "color",
        "$value": "#8bec8b"
      },
      "12": {
        "$type": "color",
        "$value": "#f485cd"
      },
      "13": {
        "$type": "color",
        "$value": "#879f03"
      },
      "14": {
        "$type": "color",
        "$value": "#e6c0fe"
      },
      "15": {
        "$type": "color",
        "$value": "#42ce85"
      },
      "16": {
        "$type": "color",
        "$value": "#e28bea"
      }
    },
    "opacity": {
      "dim-previous": {
        "$type": "number",
        "$value": 0.35,
        "$description": "The previous sweep cycle, right of the playhead"
      },
      "dim-unchecked": {
        "$type": "number",
        "$value": 0.25,
        "$description": "Unchecked tracks in Compare"
      },
      "dim-waiting": {
        "$type": "number",
        "$value": 0.5,
        "$description": "A trace waiting for a trigger"
      },
      "cancel-fill": {
        "$type": "number",
        "$value": 0.16,
        "$description": "Warn colour over the sum lane where tracks cancel"
      },
      "zoom-band": {
        "$type": "number",
        "$value": 0.1,
        "$description": "Ink over the region being dragged to zoom"
      },
      "dim-disabled": {
        "$type": "number",
        "$value": 0.35,
        "$description": "Every disabled control"
      }
    },
    "font": {
      "ui": {
        "$type": "fontFamily",
        "$value": [
          "Geist",
          "system-ui",
          "sans-serif"
        ]
      },
      "value": {
        "$type": "fontFamily",
        "$value": [
          "Geist Mono",
          "ui-monospace",
          "monospace"
        ]
      }
    },
    "size": {
      "toolbar-height": {
        "$type": "dimension",
        "$value": "48px"
      },
      "status-height": {
        "$type": "dimension",
        "$value": "34px"
      },
      "control-height": {
        "$type": "dimension",
        "$value": "24px"
      },
      "screen-inset": {
        "$type": "dimension",
        "$value": "8px"
      },
      "screen-radius": {
        "$type": "dimension",
        "$value": "10px"
      },
      "trace-width": {
        "$type": "dimension",
        "$value": "1.5px"
      },
      "cursor-width": {
        "$type": "dimension",
        "$value": "1px"
      },
      "font-ui": {
        "$type": "dimension",
        "$value": "12.5px"
      },
      "font-value": {
        "$type": "dimension",
        "$value": "12px"
      },
      "font-label": {
        "$type": "dimension",
        "$value": "11px"
      },
      "radius-control": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "A group's outer ends: a capsule at the 24 px control height"
      },
      "radius-inner": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Corners between controls of a group"
      },
      "radius-thumb": {
        "$type": "dimension",
        "$value": "10px",
        "$description": "A thumb, concentric in its track (12 − 2)"
      },
      "radius-readout": {
        "$type": "dimension",
        "$value": "10px",
        "$description": "Readout panels"
      },
      "radius-tip": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Help tips and the \"+n\" list"
      },
      "radius-popover": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "Popovers"
      },
      "gap-inner": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Between controls of a group"
      },
      "group-space": {
        "$type": "dimension",
        "$value": "13px",
        "$description": "Between groups in a bar, whatever the bar's own gap"
      }
    },
    "shadow": {
      "rim": {
        "$type": "shadow",
        "$value": [
          {
            "color": "{sl.color.rim-top}",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "0px",
            "spread": "0px",
            "inset": true
          }
        ],
        "$description": "Bar controls' rim: a faint highlight along the top, no line all round"
      },
      "rim-open": {
        "$type": "shadow",
        "$value": [
          {
            "color": "{sl.color.rim-open-top}",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "0px",
            "spread": "0px",
            "inset": true
          }
        ],
        "$description": "An open menu's rim"
      },
      "popover": {
        "$type": "shadow",
        "$value": [
          {
            "color": "{sl.color.rim-top}",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "0px",
            "spread": "0px",
            "inset": true
          },
          {
            "color": "{sl.color.popover-rim-edge}",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "1px",
            "inset": true
          },
          {
            "color": "{sl.color.popover-drop}",
            "offsetX": "0px",
            "offsetY": "16px",
            "blur": "40px",
            "spread": "0px"
          }
        ],
        "$description": "A popover's inner edge and drop"
      },
      "thumb": {
        "$type": "shadow",
        "$value": [
          {
            "color": "{sl.color.thumb-shade}",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0px"
          }
        ],
        "$description": "A chosen thumb, raised in its track"
      }
    }
  }
}
