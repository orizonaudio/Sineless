{
  "$description": "Sineless plugin tokens (DTCG format). Dark only, Graphite treatment, accent on Frozen.",
  "sl": {
    "color": {
      "case": {
        "$type": "color",
        "$value": "#18181b",
        "$description": "Window chrome: toolbar, status bar and the frame around the screen"
      },
      "control": {
        "$type": "color",
        "$value": "#26262a",
        "$description": "Fields, segmented controls and buttons at rest"
      },
      "popover": {
        "$type": "color",
        "$value": "#222226",
        "$description": "Open popovers and the cursor readout"
      },
      "line": {
        "$type": "color",
        "$value": "#2b2b30",
        "$description": "Dividers and the screen's edge"
      },
      "selected": {
        "$type": "color",
        "$value": "#f5f5f7",
        "$description": "The selected option, and toggles that are on"
      },
      "on-selected": {
        "$type": "color",
        "$value": "#0b0b0c",
        "$description": "Text on a selected option"
      },
      "ink": {
        "$type": "color",
        "$value": "#f5f5f7",
        "$description": "Primary text, values, cursors"
