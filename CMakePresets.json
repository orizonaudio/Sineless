{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug build with tests",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release build",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "tsan",
      "displayName": "macOS glue: the editor's web view tests under ThreadSanitizer",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "ORIZON_THREAD_SANITIZER": "ON",
        "SMTG_RUN_VST_VALIDATOR": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "macOS glue: the editor's web view and Audio Unit tests under AddressSanitizer",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "ORIZON_ADDRESS_SANITIZER": "ON",
        "SMTG_RUN_VST_VALIDATOR": "OFF"
      }
    },
    {
      "name": "rtsan",
      "displayName": "macOS glue: the Audio Unit's render under RealtimeSanitizer (Clang 20+, not AppleClang)",
      "binaryDir": "${sourceDir}/build/rtsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "ORIZON_REALTIME_SANITIZER": "ON",
        "SMTG_RUN_VST_VALIDATOR": "OFF"
      }
    },
    {
      "name": "bench",
      "displayName": "Optimised build of the performance benchmark",
      "binaryDir": "${sourceDir}/build/bench",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "BUILD_TESTING": "OFF",
        "ORIZON_BENCH": "ON",
        "SMTG_RUN_VST_VALIDATOR": "OFF"
      }
    },
    {
      "name": "bench-debug",
      "displayName": "Debug build of the performance benchmark, as the dev plugin",
      "binaryDir": "${sourceDir}/build/bench-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "BUILD_TESTING": "OFF",
        "ORIZON_BENCH": "ON",
        "SMTG_RUN_VST_VALIDATOR": "OFF"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64, with tests",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/windows-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-glue",
      "displayName": "Windows x64 glue: the editor's web view tests under AddressSanitizer",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/windows-x64-glue",
      "cacheVariables": {
        "ORIZON_ADDRESS_SANITIZER": "ON",
        "SMTG_RUN_VST_VALIDATOR": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64, with tests",
      "architecture": {
        "value": "ARM64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/windows-arm64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-bench",
      "displayName": "Windows x64, optimised audio benchmark",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/windows-x64-bench",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "ORIZON_BENCH": "ON",
        "SMTG_RUN_VST_VALIDATOR": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-checks",
      "hidden": true,
      "description": "The shared-code checks on Linux (scripts/check-linux.sh), with LLVM 23 as in CI and tools/linux-checks",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-23",
        "CMAKE_CXX_COMPILER": "clang++-23",
        "ORIZON_ENGINE_ONLY": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux",
      "inherits": "linux-checks",
      "displayName": "Linux: engine, plugin and editor tests under AddressSanitizer and LeakSanitizer",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "ORIZON_ADDRESS_SANITIZER": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "inherits": "linux-checks",
      "displayName": "Linux: concurrency tests under ThreadSanitizer",
      "binaryDir": "${sourceDir}/build/linux-tsan",
      "cacheVariables": {
        "ORIZON_THREAD_SANITIZER": "ON",
        "SMTG_RUN_VST_VALIDATOR": "OFF"
      }
    },
    {
      "name": "linux-rtsan",
      "inherits": "linux-checks",
      "displayName": "Linux: real-time tests under RealtimeSanitizer",
      "binaryDir": "${sourceDir}/build/linux-rtsan",
      "cacheVariables": {
        "ORIZON_REALTIME_SANITIZER": "ON",
        "SMTG_RUN_VST_VALIDATOR": "OFF"
      }
    },
    {
      "name": "mutation",
      "displayName": "Linux: engine tests built for mutation testing with Mull (scripts/mutation-cpp.sh)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mutation-cpp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-fpass-plugin=/usr/lib/mull-ir-frontend-18 -g -grecord-command-line",
        "ORIZON_ENGINE_ONLY": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "coverage",
      "displayName": "Linux: engine and protocol tests with source-based coverage (Clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ORIZON_ENGINE_ONLY": "ON",
        "ORIZON_COVERAGE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Linux: libFuzzer targets under AddressSanitizer and UBSan (Clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ORIZON_ENGINE_ONLY": "ON",
        "ORIZON_FUZZ": "ON",
        "BUILD_TESTING": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "targets": ["editor_tests"]
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "targets": ["editor_tests", "au_tests"]
    },
    {
      "name": "rtsan",
      "configurePreset": "rtsan",
      "targets": ["au_tests"]
    },
    {
      "name": "bench",
      "configurePreset": "bench",
      "targets": ["perf_bench", "process_bench"]
    },
    {
      "name": "bench-debug",
      "configurePreset": "bench-debug",
      "targets": ["perf_bench", "process_bench"]
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-glue",
      "configurePreset": "windows-x64-glue",
      "configuration": "Release",
      "targets": ["editor_tests"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64-debug",
      "configurePreset": "windows-arm64",
      "configuration": "Debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "targets": ["Sineless"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64",
      "configuration": "Release",
      "targets": ["Sineless"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-bench",
      "configurePreset": "windows-x64-bench",
      "configuration": "Release",
      "targets": ["process_bench"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "environment": {
        "LSAN_OPTIONS": "suppressions=${sourceDir}/tools/sanitizers/lsan-suppressions.txt"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-rtsan",
      "configurePreset": "linux-rtsan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "mutation",
      "configurePreset": "mutation",
      "targets": ["engine_tests"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^EditorTest\\."
        }
      },
      "execution": {
        "jobs": 4,
        "noTestsAction": "error"
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "name": "^(EditorTest\\.|AudioUnit)"
        }
      }
    },
    {
      "name": "rtsan",
      "configurePreset": "rtsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "name": "^AudioUnit"
        }
      }
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "windows-x64-glue",
      "configurePreset": "windows-x64-glue",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^EditorTest\\."
        }
      },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:windows_fast_fail_on_error=1"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "windows-arm64-debug",
      "configurePreset": "windows-arm64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/tools/sanitizers/lsan-suppressions.txt"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "CaptureRing|AnalysisWorker|Timeline|InstanceRegistry"
        }
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "execution": {
        "jobs": 4,
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-rtsan",
      "configurePreset": "linux-rtsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "PassThrough|Processor"
        }
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "execution": {
        "jobs": 4,
        "noTestsAction": "error"
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "LLVM_PROFILE_FILE": "${sourceDir}/build/coverage/profiles/%m-%p.profraw"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "execution": {
        "jobs": 4
      }
    }
  ]
}
